# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
DISCORD_PUBLIC_KEY=your_application_public_key_hex
DISCORD_BOT_TOKEN=your_bot_token

# Used only by `npm run register` (run from your own machine):
DISCORD_APPLICATION_ID=your_application_id
# Optional: register commands for one server only (updates instantly while testing)
# DISCORD_GUILD_ID=your_test_server_id

# Recording. One bot does everything: this DISCORD_BOT_TOKEN is the same bot the GitHub recorder logs in as
# (set it there as the repo secret DISCORD_TOKEN). WORKER_SHARED_SECRET is a long random string; the same
# value goes in the GitHub repo secret WORKER_SHARED_SECRET.
# WORKER_SHARED_SECRET=long_random_string

# Google Calendar sync (optional). The same value goes in every meeting organizer's Apps Script property BOT_SECRET.
# BRIDGE_SECRET=long_random_string
