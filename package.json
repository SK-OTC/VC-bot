{
  "name": "vc-bot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "One Discord bot: /new-meeting reminders and recording commands on Cloudflare Workers + D1, plus a GitHub Actions recorder that joins voice, transcribes and summarises meetings",
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"test/*.test.js\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vc-bot --local",
    "db:migrate:remote": "wrangler d1 migrations apply vc-bot --remote",
    "register": "node scripts/register-commands.mjs",
    "smoke": "node scripts/smoke.mjs",
    "record": "node --env-file=.env record-test.mjs",
    "transcribe": "node transcribe.mjs",
    "record-meeting": "node record.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "prism-media": "^1.3.5",
    "wrangler": "^4"
  }
}
